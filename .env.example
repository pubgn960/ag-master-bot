# ==============================================================================
# ITECH AVENGERS BOT ENGINE CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Server & Runtime Configuration
PORT=3000
NODE_ENV=production

# Database (PostgreSQL)
# Format: postgres://username:password@hostname:5432/dbname
DATABASE_URL=postgres://user:password@localhost:5432/cgbot

# Security & KMS Key for Credential Encryption at Rest (32 hex bytes / 64 hex characters)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY_VERSION=v1

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_WEBHOOK_URL=https://your-domain.up.railway.app/api/webhooks/telegram
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_token_here

# Owner & Internal Channels
OWNER_TELEGRAM_USER_ID=123456789
ALL_ORDERS_CHAT_ID=-1001234567890
PAYMENT_VERIFICATION_CHAT_ID=-1001234567891

# AI & Multimodal Order Extraction
GEMINI_API_KEY=AIzaSy...

# Cloud Hosting (Railway)
RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app
